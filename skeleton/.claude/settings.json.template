{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/guards/block-zones.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/guards/block-large-edit.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/guards/block-zones.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/guards/nudge.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/guards/sensor.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/guards/gate.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/load-context.sh\""
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/guards/log-instructions.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Сессия завершается. Если была реальная работа — выполни логику `.claude/skills/end-session/SKILL.md` НАПРЯМУЮ (слэш-команду вызвать нельзя, если она disable-model-invocation): triage буфера наблюдений (one-off → log, повторяемое правило → новый раздел в gotchas/реестре правил, ADR → decisions), затем запись в лог вики через `scripts/log-append.sh` (Что сделал / Что удивило / Что завтра) и очистка буфера. Путь лога берётся из ЛИЧНОГО конфига в `~/.harness/` — не из `.harness.conf`, тот версионируется. Путь не задан или файла нет — шаги про вику пропускаются молча, это законная конфигурация, а не сбой. Если работы не было — ничего не делай."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(<TEST_CMD> *)",
      "Bash(bash .claude/guards/*.sh)"
    ]
  }
}
