# .harness.conf — конфигурация харнесса для этого проекта
# Скопируй в корень репо как `.harness.conf`, заполни под свой проект.
# Этот файл читается скриптами в .claude/guards/ и .claude/commands/

# --- Sensor ---

# Директория за которой следит хук при изменениях файлов.
# Используется в run-test-hook.sh для фильтрации (нет изменений → молчим).
# Пример: "packages/<пакет>/lib" или "src"
WATCH_DIR="src"

# Команда запуска тестов. Должна принимать список файлов как аргументы.
# ВАЖНО: локальные JS-бинари (vitest/jest) — через `npx` / `pnpm exec`, иначе хук их не найдёт:
# PostToolUse запускается без node_modules/.bin в PATH → `command not found` → ложный «Tests FAILED».
# Пример: "npx vitest related --run" · "npx jest --testPathPattern" · "uv run pytest -q"
TEST_CMD="npx vitest related --run"

# --- Guard ---

# Зоны которые запрещено редактировать напрямую (генерированные файлы).
# Пробел-разделённый список директорий.
# Хук block-zones.sh вернёт exit 2 при попытке записи в эти пути.
READONLY_ZONES="dist"

# Пороги guard'а на размер правки (block-large-edit.sh). Все три опциональны, дефолты в скрипте.
# LARGE_EDIT_KB — с какого размера файла Edit БЛОКИРУЕТСЯ (дефолт 40). Причина не в стиле:
#   Edit-тул дифает файл целиком, замер — 17 минут на 50KB. Правка идёт через Bash in-place.
# LARGE_WRITE_LINES / LARGE_WRITE_KB — с какого объёма Write в .md/.txt ПРЕДУПРЕЖДАЕТ
#   (дефолт 60 строк / 6KB). Не блокирует: PreToolUse срабатывает, когда содержимое уже
#   сгенерировано, и запрет тут ничего не сэкономил бы. Порог совпадает с порогом делегирования
#   объёмного дока агенту `scribe` из workflow.md — одно число в двух местах намеренно.
LARGE_EDIT_KB="40"
LARGE_WRITE_LINES="60"
LARGE_WRITE_KB="6"

# --- Gate (Ярус 2/3) ---

# Ярус 2 (Stop hook + база pre-push): repo-wide проверка БЕЗ полных тестов.
# Sensor пофайловый — он не ловит type-ошибки по проекту, линт, сборку и
# поломки конфигов. Gate ловит. Пусто → fail-open (gate выключен).
# ВАЖНО: пустой GATE_CMD при СУЩЕСТВУЮЩЕМ .harness.conf gate печатает строкой в stderr
# (и в systemMessage на Stop). «Харнесс не настроен» молчит законно, «гейт вычищен при
# настроенном харнессе» — нет: молчаливый зелёный там неотличим от пройденной проверки.
# Тестов тут нет намеренно: полный прогон медленный для каждого хода агента,
# на Stop их закрывает sensor (TEST_CMD пофайлово). Примеры:
#   turbo:  "turbo type-check lint build"
#   npm:    "npm run type-check && npm run lint && npm run build"
GATE_CMD="turbo type-check lint build"

# Ярус 3 (только pre-push): полный прогон тестов поверх GATE_CMD.
# Push — редкое событие, медленно допустимо; turbo-кэш делает cache-hit
# почти мгновенным. Дыра, которую закрывает: массовый lint:fix/format через
# Bash обходит sensor (он ловит только Edit/Write) → снапшоты/тесты ломаются
# молча и всплывают только в CI. Пусто → тесты на push не гоняются. Примеры:
#   turbo:  "turbo test"
#   npm:    "npm run test"
GATE_TEST_CMD="turbo test"

# Откуда запускать GATE_CMD (по умолчанию REPO_ROOT). Обычно пусто.
GATE_WORKDIR=""

# Секрет-скан на Ярусе 3. Push — последняя точка, где ключ ещё не ушёл наружу: после него
# ротация обязательна, даже если коммит удалён.
# Пусто → скана нет, и pre-push пишет об этом строкой (при существующем .harness.conf):
# отсутствие проверки неотличимо от пройденной, а цена ошибки — утёкший ключ.
# gitleaks: сканирует рабочее дерево локально, секунды. Пример:
#   SECRET_SCAN_CMD="gitleaks detect --no-banner --redact"
# Не trufflehog по умолчанию: он верифицирует находки через API провайдера — это десятки
# секунд и сетевой запрос на каждый push.
SECRET_SCAN_CMD=""

# --- Покрытие изменённых строк (Ярус 3, scripts/check-diff-coverage.sh) ---

# Считается покрытие ТОЛЬКО изменённых строк, не проекта. Пары «файл ↔ парный тест» тут нет
# намеренно: такая проверка краснеет на рефакторинге, переименовании и правке конфигов, и
# лечится это флагом-обходом, который в итоге ставят всегда. Скоуп на diff снимает проблему без
# исключений — правка без новой логики не добавляет непокрытых строк.
# Проверки «тест написан раньше кода» здесь нет и быть не может: хук видит состояние дерева, а
# не последовательность появления строк, а rebase/squash стирают порядок задним числом.

# Путь к отчёту покрытия в формате Cobertura XML. Пусто → проверка молчит и не работает.
#   pytest:  "uv run pytest --cov --cov-report=xml" даёт coverage.xml
#   vitest:  reporter 'cobertura' в конфиге → coverage/cobertura-coverage.xml
#   dotnet:  coverlet с /p:CoverletOutputFormat=cobertura
COVERAGE_REPORT=""

# База сравнения. Пусто → upstream текущей ветки, иначе master/main. Считается от merge-base,
# поэтому чужие коммиты в базовой ветке в diff не попадают.
DIFF_COVER_BASE=""

# Порог ratchet в процентах. В отличие от порога непокрытых AC, этот двигается в сторону
# СТРОГОСТИ (вверх): растёт покрытие — поднимай. Опускать — осознанной правкой файла, которая
# видна в ревью. Флага «пропустить» у скрипта нет намеренно.
DIFF_COVER_BASELINE="$REPO_ROOT/scripts/check-diff-coverage.baseline"

# --- Сверка «критерий приёмки ↔ тест» (scripts/check-ac-refs.sh) ---

# У каждого AC-ID из спеки обязана быть хотя бы одна ссылка из теста. Дыра иначе
# невидима: галочку `[x]` в спеке ставит себе сам автор, и покрытие требований
# остаётся единственной непроверяемой частью работы.
# Работает на двух ярусах по-разному: на Stop (gate) — строка предупреждения без блока,
# на pre-push — блокировка. Блокировать на Stop нельзя: проверка краснела бы на том же ходе,
# где спека с новыми критериями написана, а тестов по ней ещё нет. Ждать до push тоже плохо —
# между спекой и push помещается вся работа.
# ID берутся ТОЛЬКО из чекбоксов секции `## Verification` файлов в AC_SPECS_DIR —
# упоминание того же ID в «Изменениях» критерием не считается.

# Формат ID. Дефолт узкий намеренно: широкий (`[A-Z]+-[0-9]+`) поймал бы ADR-13
# и прочие номера решений, и проверка начала бы требовать тесты для них.
# Спек в проекте несколько → префикс кода фичи, иначе номера столкнутся: "WF2V-[0-9]+".
AC_ID_RE="AC-[0-9]+"

# Маски файлов тестов, пробел-разделённые. ПУСТО → проверка молчит и не работает:
# маски зависят от стека, честного дефолта на все языки нет.
#   vitest/jest: "*.test.ts *.test.tsx *.spec.ts"
#   pytest:      "test_*.py *_test.py"
#   go:          "*_test.go"
AC_TEST_GLOBS="*.test.ts *.test.tsx *.spec.ts"

# Где искать спеки и тесты. Пути через $REPO_ROOT — он определён к моменту чтения
# этого файла (скрипты задают его до source).
AC_SPECS_DIR="$REPO_ROOT/docs/specs"
AC_TEST_DIR="$REPO_ROOT/src"

# Порог ratchet: сколько непокрытых AC терпим. Двигается ТОЛЬКО вниз, и это охраняется:
# скрипт сверяет значение с версией в HEAD и падает, если порог вырос. Иначе обойти проверку
# было бы дешевле, чем пройти. Скрипт краснеет, когда непокрытых стало больше порога — значит
# дыру внёс этот заход. Накопленный долг в пределах порога печатается и не блокирует: иначе
# проверку выключат в первый день. Файла нет в HEAD (первичная установка) — строка, не блок.
AC_BASELINE_FILE="$REPO_ROOT/scripts/check-ac-refs.baseline"

# Spec-first: "yes" → на старте сессии без docs/specs/spec-*.md напоминание «начни со спеки».
# Пусто → напоминания нет (список активных спек выводится всё равно, если они есть).
# Флаг, а не наличие каталога: `docs/specs/_template.md` доставляется в каждый инстанс.
# SPEC_FIRST="yes"

# Куда пишет лог загрузок инструкций (log-instructions.sh) и откуда читает отчёт
# (instructions-report.sh). Пара отвечает на вопрос, который иначе решается на веру:
# доезжает ли scoped-правило до контекста или файл с глобом мёртв.
METRICS_DIR="docs/metrics"

# Формат заголовка записи в реестре ловушек (scripts/gotchas-partition.sh).
# Дефолт — формат шаблонного реестра: `## §7 — правило одной строкой`.
# Проект нумерует иначе (`## Gotcha 7:`) → задай свой префикс, иначе скрипт откажется работать.
# Отказ намеренный: с чужим префиксом он не распознал бы ни одной записи и увёл БЫ ВЕСЬ
# реестр в архив, отчитавшись «множества ID совпали» — оба пустые.
GOTCHA_ID_PREFIX="## §"

# --- Memory ---

# WIKI_PATH здесь НЕ заполнять: файл версионируется, адрес вики личный.
# Личный слой — `~/.harness/<имя-каталога-репо>.conf` (или $HARNESS_LOCAL_CONF), одна строка:
#     WIKI_PATH="$HOME/wiki/projects/<проект>-harness"
# load-context.sh читает его ПОСЛЕ этого файла. Вики нет — слой опциональный, скрипт молчит.

# --- Harness version ---

# Реальная версия CORE — в `.copier-answers.yml` (её пишет Copier при copier copy/update).
# Отставание сверяется с git-тегом шаблона (`git -C <template> describe --tags`): отдельного
# файла VERSION больше нет, он расходился с тегами.
# Отдельного HARNESS_VERSION здесь намеренно НЕТ: дублирующее поле никто не читает
# (harness-status.sh сверяет diff'ы файлов, не версию) и оно молча расходится с .copier-answers.yml.

# --- Repo ---

# Корень репозитория (обычно $PWD при запуске хука).
# Переопределяй только если структура нестандартная.
REPO_ROOT="${REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"

# --- Python preset (раскомментируй вместо turbo/npm выше) ---
# В Python нет шага build → gate = lint + typecheck (без build).
# Sensor использует .claude/guards/run-pytest-hook.sh (не run-test-hook.sh):
# у pytest нет нативного "related tests", выбор тестов решает PYTEST_MODE.
# ВАЖНО: settings.json по умолчанию шьёт run-test-hook.sh в PostToolUse. Для Python
# замени там команду на run-pytest-hook.sh — иначе `pytest <исходник>` соберёт 0 тестов
# и даст ложные «Tests FAILED» на каждой правке не-теста.
#
# WATCH_DIR="src"
# TEST_CMD="uv run pytest -q"          # без uv: "pytest -q"
# PYTEST_MODE="testmon"                # testmon (граф зависимостей) | map (парный тест)
# READONLY_ZONES="__pycache__ .pytest_cache .mypy_cache .ruff_cache dist build .egg-info .venv"
#   # RAG-проект: добавь генерируемые "chroma_db data"
# GATE_CMD="uv run ruff check . && uv run ruff format --check . && uv run mypy ."
# GATE_TEST_CMD="uv run pytest"        # полный прогон на pre-push (Ярус 3)

# --- .NET preset (ASP.NET Core Web API, SDK 9/10) ---
# Проверено факт-чеком по докам MS, исходникам SDK/MSBuild и спискам диагностик.
#
# WATCH_DIR="src"
#
# Сенсор пофайлово в .NET не работает: у `dotnet test` нет аналога "related tests",
# прогон идёт проектом целиком. Пустой TEST_CMD = сенсора нет, тесты закрывает Ярус 3.
# Замерь у себя: если полный прогон укладывается в пару секунд, поставь сюда команду
# из GATE_TEST_CMD, иначе каждая правка будет стоить минуту ожидания.
# TEST_CMD=""
#
# GATE_CMD="dotnet build App.sln -p:TreatWarningsAsErrors=true -p:EnforceCodeStyleInBuild=true -clp:ErrorsOnly -v:q --nologo"
#   # Путь к solution ЯВНО: при двух файлах (.sln и .slnx) MSBuild отказывается выбирать (MSB1011).
#   # TreatWarningsAsErrors — красит CS*, CA*, IDE*, NU*. НЕ покрывает MSB*/NETSDK*: ключ
#   #   `-warnAsError` намеренно не ставим, он краснит гейт на средовом шуме (конфликты RAR)
#   #   и не глушится через NoWarn по проектам.
#   # Обратная сторона: под свойство попадают NuGetAudit NU1901–NU1904, поэтому новая CVE
#   #   краснит гейт без правок кода. Глушить в csproj (WarningsNotAsErrors), не в команде.
#   # EnforceCodeStyleInBuild — в CLI-сборке анализаторы стиля (IDE*) выключены по умолчанию.
#   # -clp:ErrorsOnly режет видимость, не код выхода: без TreatWarningsAsErrors гейт зелёный.
#   # -clp:NoSummary НЕ добавлять: gate.sh читает хвост вывода, а вердикт и счётчики
#   #   «N Warning(s) / N Error(s)» печатаются в самом конце — NoSummary срезает ровно их.
#   # --no-restore НЕ добавлять: без restore новый PackageReference не попадёт в ссылки —
#   #   в лучшем случае CS0246, в худшем зелёная сборка со старыми зависимостями.
#   # -m не нужен: `dotnet build` всегда сам добавляет беззначный -maxcpucount.
#
# GATE_TEST_CMD — три формы, выбирай по SDK и раннеру. Раннер переключается ТОЛЬКО через
# global.json ({"test":{"runner":"Microsoft.Testing.Platform"}}), флага CLI нет; на SDK ≤ 9
# секция игнорируется молча. `--no-build` уже включает `--no-restore`, дублировать не нужно,
# но требует готовой сборки — билд идёт отдельным шагом до тестов.
#   SDK ≥ 10 + MTP:  GATE_TEST_CMD="dotnet test --solution App.sln --no-build -- --ansi off --progress off"
#   SDK 9 + MTP:     GATE_TEST_CMD="dotnet test App.sln --no-build"
#                    # плюс <TestingPlatformDotnetTestSupport>true</...> в Directory.Build.props
#   чистый VSTest:   GATE_TEST_CMD="dotnet test App.sln --no-build"
#
# АСИММЕТРИЯ КОДОВ ВЫХОДА — главный источник ложных вердиктов. Хуки считают провалом любой
# не-нулевой код, а «ноль тестов» два раннера трактуют противоположно:
#   прогнано ноль тестов → MTP отдаёт 8 (ложный КРАСНЫЙ), VSTest отдаёт 0 (ложный ЗЕЛЁНЫЙ)
#   падения → MTP 2, VSTest 1 · невалидные аргументы → MTP 5, VSTest 1
# Рычаги разные для сенсора и гейта:
#   сенсор (MTP):  export TESTINGPLATFORM_EXITCODE_IGNORE=8   # ноль тестов перестаёт быть провалом
#   гейт (MTP):    8 НЕ глушить, добавить `--minimum-expected-tests N` — пустой прогон падёт осознанно
#   гейт (VSTest): RunConfiguration.TreatNoTestsAsError=true в .runsettings — иначе пустой прогон зелёный
# Ложный зелёный дороже ложного красного: у VSTest эту строку в .runsettings ставить обязательно.
#
# Тишину вывода задавай ПЕРЕМЕННЫМИ, не флагами: неизвестная опция CLI роняет прогон с кодом 5,
# неизвестная переменная просто игнорируется — конфиг переживает разброс версий SDK.
# export MSBUILDTERMINALLOGGER=false   # не `-tl:false` в команде: флаг может уехать в тест-хост
#
# READONLY_ZONES="bin obj artifacts TestResults publish"
#   # artifacts появляется при UseArtifactsOutput=true (.NET 8 SDK+) — тогда bin/obj уезжают внутрь.
#   # `dotnet clean` не опустошает obj: выходы restore (project.assets.json, *.nuget.g.props)
#   # остаются на месте, поэтому зона нужна именно как read-only, а не как «удаляемое».
#
# AC_TEST_GLOBS="*Tests.cs *Test.cs"
# AC_TEST_DIR="$REPO_ROOT/tests"
